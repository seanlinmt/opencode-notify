# ==============================================================================
# OpenCode Notify & Telegram Bridge Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenCode Plugin Client Settings
# ------------------------------------------------------------------------------
# URL of your ntfy instance (e.g. https://ntfy.example.com)
OPENCODE_NTFY_URL=https://ntfy.example.com

# ntfy topic name used for opencode job events
OPENCODE_NTFY_TOPIC=opencode-jobs

# Enable or disable push notifications (true / false)
OPENCODE_NTFY_ENABLED=true

# ------------------------------------------------------------------------------
# Telegram Bridge Service Settings (Remote Host)
# ------------------------------------------------------------------------------
# Internal ntfy endpoint accessed by the bridge container
NTFY_URL=https://127.0.0.1:18080

# Topic to subscribe to
NTFY_TOPIC=opencode-jobs

# Whether to verify SSL certificates when connecting to the internal ntfy stream
NTFY_SSL_VERIFY=false

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Chat ID (User ID or Group ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
